{
  "name": "sd-card-forensics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "浏览器内运行的存储卡取证工作站（FAT32 / exFAT / 删除恢复 / 雕刻 / 时间线 / 监管链 / PDF 报告）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "test": "vitest run",
    "test:core": "vitest run tests/core",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test:core && npm run test:e2e"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
